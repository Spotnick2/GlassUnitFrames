package-as: GlassUnitFrames

enable-nolib-creation: no

# Without this the packager writes a CHANGELOG.md from git history into the zip.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# The glass material. Pinned, never `tag: latest` (the packager picks the
# newest tag by creation date and falls back to the branch HEAD). Bump the pin
# only in a release made anyway: players get library fixes earlier through
# whichever glass addon ships the newest copy, since LibStub runs that one.
# CI reads the pin from here, so it is written once.
#
# No comment on a value line: the packager's YAML reader keeps it as part of
# the value (it tried to check out "562da7b   # ...").
externals:
  Libs/LibGlass-1.0:
    url: https://github.com/Spotnick2/LibGlass
    tag: r11
  # Flight times (#153), shared with GlassPanel's Flight plugin. The same
  # rules: pinned to a tag, never latest; CI reads the pin from here.
  Libs/LibTaxiTime-1.0:
    url: https://github.com/Spotnick2/LibTaxiTime
    tag: r1

# YAML list, not markdown bullets. Every pattern matches the WHOLE path from
# the package root (release.sh's match_pattern is a shell `case`), so the
# top-level names below never reach inside Libs/. Three LICENSE files ship: the
# addon's own (MIT), Libs/LibGlass-1.0/LICENSE and Libs/LibTaxiTime-1.0/LICENSE
# (both MIT).
ignore:
  - .github
  - docs
  - tests
  - Tools
  - AGENTS.md
  - CLAUDE.md
  - README.md
  - README.curseforge.md
  - CHANGELOG.md
  # The library's own .pkgmeta ignores these, and the BigWigs packager honours
  # that; CurseForge's packager, which builds the release, does NOT (measured
  # in Priestly's published zip, Priestly #53). So they are named from here.
  # CI asserts what the zip holds under Libs/LibGlass-1.0/.
  - Libs/LibGlass-1.0/tests
  - Libs/LibGlass-1.0/docs
  - Libs/LibGlass-1.0/Tools
  - Libs/LibGlass-1.0/AGENTS.md
  - Libs/LibGlass-1.0/CLAUDE.md
  - Libs/LibGlass-1.0/README.md
  - Libs/LibTaxiTime-1.0/tests
  - Libs/LibTaxiTime-1.0/docs
  - Libs/LibTaxiTime-1.0/Tools
  - Libs/LibTaxiTime-1.0/AGENTS.md
  - Libs/LibTaxiTime-1.0/CLAUDE.md
  - Libs/LibTaxiTime-1.0/README.md
